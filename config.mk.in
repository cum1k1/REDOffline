# the configured options and settings for REDOffline

CC      = @CMAKE_C_COMPILER@
CFLAGS  = @CMAKE_C_FLAGS@
CPP     = $(CC) -E
CPPFLAGS+= @my_CPP_FLAGS@
CXX     = @CMAKE_CXX_COMPILER@
CXXCPP  = $(CXX) -E
CXXFLAGS+= @CMAKE_CXX_FLAGS@
LD      = @CMAKE_LINKER@
LDFLAGS += @CMAKE_EXE_LINKER_FLAGS@ @my_LD_FLAGS@
LIBS    = 

CMAKE   = @CMAKE_COMMAND@
GIT     = @GIT_EXECUTABLE@
TAR     = @TAR@
ifeq (@PYTHONLIBS_FOUND@,TRUE)
  HAVE_PYTHON = yes
  PYTHON         = @PYTHON_EXECUTABLE@
  PYTHON_INCLUDE := $(addprefix -I,@PYTHON_INCLUDE_DIRS@)
  PYTHON_LIBS    = @PYTHON_LIBRARY@
endif
ifeq (@ROOT_FOUND@,TRUE)
  HAVE_ROOT = yes
  ROOT_CONFIG  = @ROOT_CONFIG_EXECUTABLE@
  ROOT_INCDIR  = @ROOT_INCLUDE_DIRS@
  ROOT_INCLUDE := $(addprefix -I,@ROOT_INCLUDE_DIRS@)
  ROOT_LIBDIR  = @ROOT_LIBRARY_DIRS@
  ROOT_LIBS    := $(subst ;, ,@ROOT_LIBRARIES@)
  ROOFIT_LIBS  := $(addsuffix .so,$(addprefix $(ROOT_LIBDIR)/lib,RooFit RooFitCore Minuit Foam))
  ROOTEXEC     := $(shell @ROOT_CONFIG_EXECUTABLE@ --bindir)/root
  ROOTCINT     = @ROOTCINT_EXECUTABLE@
endif
ifeq (@LUA_FOUND@,TRUE)
  HAVE_LUA = yes
  LUA_INCLUDE = -I@LUA_INCLUDE_DIR@
  LUA_LIBS    = @LUA_LIBRARY@
endif
BZIP2   = @BZIP2_EXECUTABLE@
ASTYLE  = @ASTYLE_EXECUTABLE@
CTAGS   = @CTAGS_EXECUTABLE@

PACKAGE_NAME = @PROJECT_NAME@
PACKAGE_STRING = "@PROJECT_NAME@ @REDOffline_VERSION@"
PACKAGE_TARNAME = @REDOffline_TOLOW@
PACKAGE_VERSION = @REDOffline_VERSION@

PACKAGE_GIT_DIR = @PROJECT_SOURCE_DIR@/.git
PACKAGE_GIT_VERSION := $(shell $(GIT) --git-dir=$(PACKAGE_GIT_DIR) describe --tags HEAD)

